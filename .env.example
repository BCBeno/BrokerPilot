# BrokerPilot: variabile de mediu. Copiază în `.env` (nu intră în git) și completează.
# Secretele stau doar în `.env` / GitHub Secrets. Lista de conturi: docs/SETUP.md și docs/spec/10-infra-cicd.md (secțiunea 20).
# Cuvântul <domeniu> înseamnă domeniul tău din Cloudflare.

# ---------- app (Next.js) ----------
# URL-ul public al aplicației (client + dashboard). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase: Project Settings → API. URL-ul proiectului
NEXT_PUBLIC_SUPABASE_URL=
# Supabase: cheia publică „anon” (e protejată de RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase: cheia „service_role”. SECRETĂ, doar pe server, ocolește RLS
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: conexiune Postgres directă (pentru `supabase db push` și validări; opțional în runtime)
SUPABASE_DB_URL=
# Baza URL a webhook-urilor n8n (n8n-ul tău existent din celălalt LXC), apelate din app
N8N_WEBHOOK_BASE=https://n8n.<domeniu>/webhook
# Adresa n8n din rețeaua locală, folosită de /api/health (ex. http://192.168.1.50:5678)
N8N_INTERNAL_URL=
# Secretul comun trimis în antetul X-BP-Secret către/dinspre n8n (generează: openssl rand -hex 32)
BP_WEBHOOK_SECRET=
# Vapi: cheia publică (poate ajunge în browser)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Vapi: ID-ul asistentului creat în S5
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Vapi: secretul serverului, verificat de n8n în antetul x-vapi-secret
VAPI_SERVER_SECRET=
# Vapi: cheia privată (doar pentru crearea asistentului/tools prin API)
VAPI_API_KEY=

# ---------- AI ----------
# OpenRouter: LLM și vision (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Groq: clasificare rapidă și Whisper (https://console.groq.com/keys)
GROQ_API_KEY=
# Google AI Studio: embeddings Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modele per task, ID-uri OpenRouter (ex. anthropic/claude-haiku-5-5). Se aleg în S3
# extragere din poze (vision)
MODEL_VISION=
# chat/copilot RAG
MODEL_CHAT=
# sarcini simple și ieftine (rezumate, checklist)
MODEL_CHEAP=
# clasificare email/intenție (Groq)
MODEL_CLASSIFY=
# plafon zilnic de cost AI în USD; gateway-ul refuză apelurile peste plafon
AI_DAILY_BUDGET_USD=5

# ---------- n8n (rulează în alt LXC, deja existent) ----------
# URL-ul n8n pentru n8n-mcp și `npm run n8n:export` (fără /api/v1)
N8N_API_URL=
# Cheia API din n8n: Settings → n8n API
N8N_API_KEY=

# ---------- Telegram ----------
# Botul clientului (BotFather)
TG_CLIENT_BOT_TOKEN=
# Botul brokerului (BotFather)
TG_BROKER_BOT_TOKEN=
# chat_id-urile brokerilor autorizați, separate prin virgulă (le afli de la @userinfobot)
TG_BROKER_CHAT_IDS=
# chat_id-ul grupului Telegram „BrokerPilot Ops” (negativ, ex. -100123...): alerte tehnice (WF99, deploy, buget AI), trimise tot prin botul broker
TG_OPS_CHAT_ID=

# ---------- infra ----------
# Proprietarul GitHub pentru imaginea ghcr.io/<owner>/brokerpilot-web (litere mici)
GHCR_OWNER=
# Tag-ul imaginii web; la deploy = SHA-ul commit-ului, la rollback = SHA-ul anterior
IMAGE_TAG=latest
# Numărul operatorului uman pentru transfer apel, format E.164 (ex. +407XXXXXXXX)
OPERATOR_PHONE_E164=

# ---------- identitate (OTP) ----------
# Twilio Verify pentru OTP SMS (în trial, numărul tău trebuie verificat în Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Resend: trimitere email OTP/notificări
RESEND_API_KEY=
# Secret („pepper”) pentru hash-ul codurilor OTP (openssl rand -hex 32)
OTP_HASH_PEPPER=
