    {
      "id": "parse",
      "name": "Parse report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: extrage din raportul Vapi doar câmpurile de salvat și construiește cele două rânduri; niciun nod nativ nu parcurge structura variabilă a raportului.\nconst SB = '__SUPABASE_URL__';\nconst msg = $('Webhook vapi-end-of-call').first().json.body?.message ?? {};\nif (msg.type !== 'end-of-call-report') return []; // alte evenimente: ignorate\nconst callId = msg.call?.id;\nif (!callId) throw new Error('Raport Vapi fără call.id');\nconst messages = (msg.artifact?.messages ?? msg.messages ?? [])\n  .filter((m) => ['user', 'assistant', 'bot'].includes(m.role))\n  .map((m) => ({ role: m.role === 'user' ? 'user' : 'assistant', text: String(m.message ?? m.content ?? ''), t: m.secondsFromStart ?? null }));\nconst cost = Number(msg.cost ?? msg.call?.cost ?? 0) || 0;\nconst secs = Number(msg.durationSeconds ?? 0) || 0;\nconst conversation = {\n  channel: 'voice',\n  external_id: callId,\n  summary: String(msg.summary ?? msg.analysis?.summary ?? '').slice(0, 4000) || null,\n  transcript: { text: String(msg.transcript ?? msg.artifact?.transcript ?? '').slice(0, 60000), messages: messages.slice(0, 400), endedReason: msg.endedReason ?? null, durationSeconds: secs, costUsd: cost },\n};\nconst aiCall = { workflow: 'WF03', task: 'voice_call', provider: 'vapi', model: null, cost_usd: cost, latency_ms: Math.round(secs * 1000), success: !String(msg.endedReason ?? '').includes('error'), error: String(msg.endedReason ?? '').includes('error') ? String(msg.endedReason) : null, redacted: false };\nreturn [{ json: { conversationUrl: SB + '/rest/v1/conversations?on_conflict=channel,external_id', aiCallUrl: SB + '/rest/v1/ai_calls', conversation, aiCall } }];"
      },
      "notes": "Why Code: structură variabilă a raportului Vapi."
    },
    {
      "id": "h1",
