      "id": "wf01-respond-202",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        -240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Why Code: validare de schemă + text de notificare în română; nicio combinație de noduri native nu le acoperă curat.\n// Aplicația trimite deja `missing` (checklist calculat și testat în app); aici doar îl afișăm.\nconst body = $('Webhook claim.completed').first().json.body ?? {};\nconst fail = (m) => { throw new Error(`Payload claim.completed invalid: ${m}`); };\n\nif (body.event !== 'claim.completed') fail('event');\nif (!/^[0-9a-f-]{36}$/i.test(body.claimId ?? '')) fail('claimId');\nif (typeof body.ref !== 'string' || !body.ref) fail('ref');\nif (!/^https:\\/\\//.test(body.pdfUrl ?? '')) fail('pdfUrl (trebuie https)');\nif (!body.parties?.A || !body.parties?.B) fail('parties');\nconst missing = Array.isArray(body.missing) ? body.missing : [];\n\nconst party = (p, role) => {\n  const car = [p.plate, p.vehicle].filter(Boolean).join(' ') || 'vehicul necunoscut';\n  const impact = p.impact ? `, lovit: ${p.impact}` : '';\n  const circ = p.circumstances?.length ? ` Circumstanțe: ${p.circumstances.map((c) => c.n).join(', ')}.` : '';\n  return `${role}: ${p.driver || 'șofer necunoscut'}, ${car} (${p.insurer || 'asigurător necunoscut'})${impact}.${circ}`;\n};\n\nconst blocking = missing.filter((m) => m.blocking);\nconst advisory = missing.filter((m) => !m.blocking);\nconst checklist = missing.length === 0\n  ? 'Dosar complet.'\n  : [...blocking.map((m) => `• ${m.label}`), ...advisory.map((m) => `◦ ${m.label}`)].join('\\n');\n\n// Rezumat determinist (fără LLM: datele personale nu pleacă spre un model cloud). Un rezumat AI se adaugă după WF00 (gateway cu redactare).\nconst summary = [\n  `Amiabilă ${body.ref}, ${body.occurredAt}, ${body.place}.`,\n  party(body.parties.A, 'A'),\n  party(body.parties.B, 'B'),\n  `Poze: A ${body.photoCounts?.A ?? 0}, B ${body.photoCounts?.B ?? 0}. Schiță: ${body.hasSketch ? 'da' : 'nu'}.`,\n].join('\\n');\n\nconst caption = `Dosar nou ${body.ref}\\n${body.place}\\n\\n${checklist}`.slice(0, 1000);\nconst chats = String($env.TG_BROKER_CHAT_IDS ?? '').split(',').map((s) => s.trim()).filter(Boolean);\nif (chats.length === 0) fail('TG_BROKER_CHAT_IDS lipsește');\n\nreturn chats.map((chatId) => ({\n  json: { chatId, claimId: body.claimId, ref: body.ref, pdfUrl: body.pdfUrl, caption, summary, missing },\n}));"
      },
      "id": "wf01-compose",
      "name": "Validate and compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $json.chatId }}",
        "file": "={{ $json.pdfUrl }}",
        "additionalFields": {
          "caption": "={{ $json.caption }}",
          "fileName": "={{ $json.ref }}.pdf"
        },
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Preiau",
                    "additionalFields": {
                      "callback_data": "={{ 'take:' + $json.claimId }}"
                    }
                  },
                  {
                    "text": "Cere info lipsă",
                    "additionalFields": {
                      "callback_data": "={{ 'ask:' + $json.claimId }}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
