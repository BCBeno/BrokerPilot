        "googleApi": {
          "id": "REPLACE_ME",
          "name": "Google Drive BrokerPilot (service account)"
        }
      }
    },
    {
      "id": "n26x",
      "name": "Extract text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {
          "joinPages": false
        }
      },
      "notes": "Textul PDF-ului pe pagini (Join Pages oprit), ca citările să aibă pagina."
    },
    {
      "id": "n30",
      "name": "Replace old version",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "method": "DELETE",
        "url": "__SUPABASE_URL__/rest/v1/kb_documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "=eq.{{ $('Document meta').item.json.title }}"
            },
            {
              "name": "collection",
              "value": "=eq.{{ $('Document meta').item.json.collection }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_ME",
          "name": "Supabase BrokerPilot (service role)"
        }
      },
      "notes": "Why HTTP: DELETE filtrat în PostgREST. Un document cu același titlu în aceeași colecție e înlocuit; fragmentele lui dispar prin ON DELETE CASCADE."
    },
    {
      "id": "n31",
      "name": "Insert document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__SUPABASE_URL__/rest/v1/kb_documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('Document meta').item.json.title, drive_file_id: $('Document meta').item.json.id, collection: $('Document meta').item.json.collection, insurer: $('Document meta').item.json.insurer, doc_type: $('Document meta').item.json.docType, source_url: $('Document meta').item.json.webViewLink ?? null, license_note: 'Încărcat din Google Drive (BrokerPilot KB)' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_ME",
          "name": "Supabase BrokerPilot (service role)"
        }
      },
      "notes": "Why HTTP: return=representation, ca să obținem id-ul documentului. Rămâne fără `ingested_at` până se termină ingestia."
    },
    {
      "id": "n32",
      "name": "Chunk text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: împărțire în fragmente (~3000 de caractere, suprapunere ~300) pe pagină, cu titlul secțiunii; Text Splitter din n8n există doar ca sub-nod al magazinelor vectoriale.\nconst doc = $('Insert document').first().json;\nconst raw = $('Extract text').first().json.text;\nconst title = $('Document meta').first().json.title;\n// PDF-urile românești folosesc des ş/ţ cu sedilă; întrebările folosesc ș/ț cu virgulă, deci le unificăm.\nconst clean = (t) => String(t ?? '').normalize('NFC').replace(/ş/g, 'ș').replace(/Ş/g, 'Ș').replace(/ţ/g, 'ț').replace(/Ţ/g, 'Ț')\n  .replace(/\\u00ad/g, '').replace(/[ \\t]+/g, ' ').split('\\n').map((l) => l.trim()).join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst pages = (Array.isArray(raw) ? raw : [raw]).map((t, i) => ({ page: i + 1, text: clean(t) }));\nconst MAX = 3000, OVERLAP = 300, MIN_PAGE = 40;\nconst HEADING = /^(CAPITOLUL|SECȚIUNEA|SECTIUNEA|TITLUL|ART(?:ICOLUL|\\.)?\\s*\\d+|Art\\.\\s*\\d+|\\d+(\\.\\d+)*[.)]\\s+[A-ZĂÂÎȘȚ]|[A-ZĂÂÎȘȚ][A-ZĂÂÎȘȚ0-9 ,.:;()\\/-]{7,})/;\nconst out = [];\nlet heading = null;\nfor (const p of pages) {\n  if (p.text.length < MIN_PAGE) continue;\n  // titlul din capul paginii rămâne valabil pentru restul documentului până apare unul nou\n  for (const l of p.text.split('\\n')) { if (l.length >= 6 && l.length <= 120 && HEADING.test(l)) { heading = l; break; } }\n  let start = 0;\n  while (start < p.text.length) {\n    let end = Math.min(start + MAX, p.text.length);\n    if (end < p.text.length) {\n      const cut = Math.max(p.text.lastIndexOf('\\n', end), p.text.lastIndexOf('. ', end));\n      if (cut > start + MAX * 0.5) end = cut + 1;\n    }\n    const content = p.text.slice(start, end).trim();\n    if (content.length >= MIN_PAGE) out.push({ json: { document_id: doc.id, content, page: p.page, heading, embedText: [title, heading, content].filter(Boolean).join('\\n') } });\n    if (end >= p.text.length) break;\n    start = Math.max(end - OVERLAP, start + 1);\n  }\n}\nif (!out.length) throw new Error('Documentul nu are text de indexat (PDF scanat?)');\nreturn out;\n"
      }
    },
    {
      "id": "n33",
      "name": "Embed chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"models/gemini-embedding-001\", content: { parts: [{ text: $json.embedText }] }, taskType: \"RETRIEVAL_DOCUMENT\", outputDimensionality: 768 }) }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2500
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Gemini API key (BrokerPilot)"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "notes": "Why HTTP: nodul Gemini nu expune outputDimensionality (768). Câte un fragment la 2,5 s (~24/min × ≤ ~900 tokeni), sub limita gratuită de 30k tokeni/min."
    },
    {
      "id": "n34",
      "name": "Save chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__SUPABASE_URL__/rest/v1/kb_chunks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
