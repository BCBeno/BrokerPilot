    {
      "id": "n31",
      "name": "Insert document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "__SUPABASE_URL__/rest/v1/kb_documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('Document meta').item.json.title, drive_file_id: $('Document meta').item.json.id, collection: $('Document meta').item.json.collection, insurer: $('Document meta').item.json.insurer, doc_type: $('Document meta').item.json.docType, source_url: $('Document meta').item.json.webViewLink ?? null, license_note: 'Încărcat din Google Drive (BrokerPilot KB)' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_ME",
          "name": "Supabase BrokerPilot (service role)"
        }
      },
      "notes": "Why HTTP: return=representation, ca să obținem id-ul documentului. Rămâne fără `ingested_at` până se termină ingestia."
    },
    {
      "id": "n32",
      "name": "Chunk text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: împărțire în fragmente (~1000 de caractere, suprapunere ~150) pe pagină, cu titlul secțiunii; Text Splitter din n8n există doar ca sub-nod al magazinelor vectoriale.\nconst doc = $('Insert document').first().json;\nconst raw = $('Extract text').first().json.text;\nconst meta = $('Document meta').first().json;\nconst title = meta.title;\n// PDF-urile românești folosesc des ş/ţ cu sedilă; întrebările folosesc ș/ț cu virgulă, deci le unificăm.\nconst clean = (t) => String(t ?? '').normalize('NFC').replace(/ş/g, 'ș').replace(/Ş/g, 'Ș').replace(/ţ/g, 'ț').replace(/Ţ/g, 'Ț')\n  .replace(/\\u00ad/g, '').replace(/[ \\t]+/g, ' ').split('\\n').map((l) => l.trim()).join('\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst pages = (Array.isArray(raw) ? raw : [raw]).map((t, i) => ({ page: i + 1, text: clean(t) }));\nconst MAX = 1000, OVERLAP = 150, MIN_PAGE = 40; // 3000 dădea ~3.900 de tokeni pe întrebare (ai_calls, 15 nov)\nconst HEADING = /^(CAPITOLUL|SECȚIUNEA|SECTIUNEA|TITLUL|ART(?:ICOLUL|\\.)?\\s*\\d+|Art\\.\\s*\\d+|\\d+(\\.\\d+)*[.)]\\s+[A-ZĂÂÎȘȚ]|[A-ZĂÂÎȘȚ][A-ZĂÂÎȘȚ0-9 ,.:;()\\/-]{7,})/;\nconst out = [];\nlet heading = null;\nfor (const p of pages) {\n  if (p.text.length < MIN_PAGE) continue;\n  // titlul din capul paginii rămâne valabil pentru restul documentului până apare unul nou\n  for (const l of p.text.split('\\n')) { if (l.length >= 6 && l.length <= 120 && HEADING.test(l)) { heading = l; break; } }\n  let start = 0;\n  while (start < p.text.length) {\n    let end = Math.min(start + MAX, p.text.length);\n    if (end < p.text.length) {\n      const cut = Math.max(p.text.lastIndexOf('\\n', end), p.text.lastIndexOf('. ', end));\n      if (cut > start + MAX * 0.5) end = cut + 1;\n    }\n    const content = p.text.slice(start, end).trim();\n    if (content.length >= MIN_PAGE) out.push({ json: { document_id: doc.id, title, page: p.page, heading, collection: meta.collection, insurer: meta.insurer ?? '', doc_type: meta.docType ?? '', source_url: meta.webViewLink ?? '', text: [title, heading, content].filter(Boolean).join('\\n') } });\n    if (end >= p.text.length) break;\n    start = Math.max(end - OVERLAP, start + 1);\n  }\n}\nif (!out.length) throw new Error('Documentul nu are text de indexat (PDF scanat?)');\nreturn out;\n"
      }
    },
