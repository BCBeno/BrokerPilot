    {
      "id": "n32",
      "name": "Chunk text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Why Code: împărțire în fragmente (~3000 de caractere, suprapunere ~300) pe pagină, cu titlul secțiunii; Text Splitter din n8n există doar ca sub-nod al magazinelor vectoriale.\nconst doc = $('Insert document').first().json;\nconst pages = $('Parse pages').first().json.pages ?? [];\nconst title = $('Document meta').first().json.title;\nconst MAX = 3000, OVERLAP = 300, MIN_PAGE = 40;\nconst HEADING = /^(CAPITOLUL|SECȚIUNEA|SECTIUNEA|TITLUL|ART(?:ICOLUL|\\.)?\\s*\\d+|Art\\.\\s*\\d+|\\d+(\\.\\d+)*[.)]\\s+[A-ZĂÂÎȘȚ]|[A-ZĂÂÎȘȚ][A-ZĂÂÎȘȚ0-9 ,.:;()\\/-]{7,})/;\nconst out = [];\nlet heading = null;\nfor (const p of pages) {\n  const text = String(p.text ?? '').trim();\n  if (text.length < MIN_PAGE) continue;\n  const lines = text.split('\\n');\n  // titlul din capul paginii rămâne valabil pentru restul documentului până apare unul nou\n  for (const l of lines) { const t = l.trim(); if (t.length >= 6 && t.length <= 120 && HEADING.test(t)) { heading = t; break; } }\n  let start = 0;\n  while (start < text.length) {\n    let end = Math.min(start + MAX, text.length);\n    if (end < text.length) {\n      const cut = Math.max(text.lastIndexOf('\\n', end), text.lastIndexOf('. ', end));\n      if (cut > start + MAX * 0.5) end = cut + 1;\n    }\n    const content = text.slice(start, end).trim();\n    if (content.length >= MIN_PAGE) out.push({ json: { document_id: doc.id, content, page: p.page, heading, embedText: [title, heading, content].filter(Boolean).join('\\n') } });\n    if (end >= text.length) break;\n    start = Math.max(end - OVERLAP, start + 1);\n  }\n}\nif (!out.length) throw new Error('Documentul nu are text de indexat (scanat?)');\nreturn out;"
      }
    },
    {
      "id": "n33",
