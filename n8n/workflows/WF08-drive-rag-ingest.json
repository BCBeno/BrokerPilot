        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ document_id: $('Chunk text').item.json.document_id, content: $('Chunk text').item.json.content, page: $('Chunk text').item.json.page, heading: $('Chunk text').item.json.heading, embedding: $json.embedding.values }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 10,
              "batchInterval": 100
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_ME",
          "name": "Supabase BrokerPilot (service role)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Why HTTP: inserare în kb_chunks cu coloană vector(768), pe care nodul Supabase nu o scrie corect."
    },
    {
      "id": "n35",
      "name": "All chunks saved",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        2420,
        200
      ],
      "parameters": {
        "maxItems": 1
      }
    },
    {
      "id": "n36",
      "name": "Mark ingested",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=__SUPABASE_URL__/rest/v1/kb_documents?id=eq.{{ $('Insert document').item.json.id }}",
