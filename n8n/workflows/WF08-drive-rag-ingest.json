        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $('Document meta').item.json.title, drive_file_id: $('Document meta').item.json.id, collection: $('Document meta').item.json.collection, file_hash: $('Hash file').item.json.fileHash, insurer: $('Document meta').item.json.insurer, doc_type: $('Document meta').item.json.docType, source_url: $('Document meta').item.json.webViewLink ?? null, license_note: 'Încărcat din Google Drive (BrokerPilot KB)' }) }}",
        "options": {
          "response": {
