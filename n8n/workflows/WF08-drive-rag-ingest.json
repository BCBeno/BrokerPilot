        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ingested_at: $now.toISO() }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_ME",
          "name": "Supabase BrokerPilot (service role)"
        }
      },
      "notes": "Why HTTP: UPDATE filtrat. Abia acum documentul intră în căutare (kb_search cere ingested_at)."
    },
    {
      "id": "n37",
      "name": "Notify (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2860,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ String($env.TG_BROKER_CHAT_IDS ?? '').split(',')[0].trim() }}",
        "text": "={{ '📚 KB actualizat: ' + $('Document meta').item.json.title + ' (' + $('Document meta').item.json.collection + ') — ' + $('Save chunk').all().length + ' fragmente' }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram BrokerPilotDeskBot"
        }
      }
    },
